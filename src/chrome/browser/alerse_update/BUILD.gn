import("//build/util/process_version.gni")

# alerse_version.h: the Alerse release this build is, from chrome/VERSION's
# ALERSE_VERSION (tools/rename_product.py writes it); empty without it.
process_version("version_header") {
  template_file = "alerse_version.h.in"
  sources = [ "//chrome/VERSION" ]
  output = "$target_gen_dir/alerse_version.h"
  extra_args = [
    "-e",
    "ALERSE_VERSION=locals().get('ALERSE_VERSION',str())",
  ]
}

source_set("alerse_update") {
  sources = [
    "alerse_update_checker.cc",
    "alerse_update_checker.h",
  ]
  public_deps = [
    "//base",
    "//chrome/browser:main_extra_parts",
    "//components/prefs",
    "//url",
  ]
  deps = [
    ":version_header",
    "//chrome/browser:browser_process",
    "//chrome/browser/headless",
    "//chrome/common:non_code_constants",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
  ]
  if (is_win) {
    # Removes Alerse once Alerse took over its profile.
    sources += [
      "alerse_legacy_install_win.cc",
      "alerse_legacy_install_win.h",
    ]
    deps += [ "//chrome/common:constants" ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [ "alerse_update_checker_unittest.cc" ]
  deps = [
    ":alerse_update",
    ":version_header",
    "//base",
    "//components/prefs:test_support",
    "//testing/gtest",
    "//url",
  ]
  if (is_win) {
    sources += [ "alerse_legacy_install_win_unittest.cc" ]
  }
}
